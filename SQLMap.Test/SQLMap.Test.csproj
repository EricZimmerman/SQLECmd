<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>10</LangVersion>
        <IsPackable>false</IsPackable>
        <Copyright>Eric R. Zimmerman 2027</Copyright>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageReference Include="Serilog" Version="4.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../SQLMap/SQLMaps.csproj" />
        <!-- CliTests run the built SQLECmd.dll, which this copies next to the tests -->
        <ProjectReference Include="../SQLECmd/SQLECmd.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Sample databases; their maps are SQLMap/Maps/TestFiles_*.smap -->
        <None Include="TestFiles/**" CopyToOutputDirectory="PreserveNewest" />
        <!-- Every shipped map, so the tests check that all of them load -->
        <None Include="../SQLMap/Maps/**" LinkBase="Maps" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
