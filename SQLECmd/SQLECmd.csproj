<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Version>2026.10.2</Version>
        <ApplicationIcon>DatabaseSearch.ico</ApplicationIcon>
        <LangVersion>10</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="SQLMap.Test" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Costura.Fody" Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="ERZHelpers" Version="2026.10.0" />
        <PackageReference Include="Exceptionless" Version="6.2.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="ServiceStack.OrmLite.Sqlite" Version="10.4.0" />
        <PackageReference Include="ServiceStack.Text" Version="10.4.0" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="System.CommandLine" Version="2.0.13" />
        <!-- Native SQLite.Interop libraries, copied to runtimes\<rid>\native next to SQLECmd and loaded from there by
             NativeSqlite.cs (nothing is extracted). Must be the same version as the System.Data.SQLite.Core that
             ServiceStack.OrmLite.Sqlite brings in; CheckSqliteNatives below fails the build if not -->
        <PackageReference Include="Stub.System.Data.SQLite.Core.NetStandard" Version="1.0.119" GeneratePathProperty="true" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SQLMap\SQLMaps.csproj" />
    </ItemGroup>
    <Target Name="CheckSqliteNatives" AfterTargets="ResolvePackageAssets">
        <ItemGroup>
            <_SdsCore Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'System.Data.SQLite.Core'" />
            <_SdsStub Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Stub.System.Data.SQLite.Core.NetStandard'" />
        </ItemGroup>
        <PropertyGroup>
            <_SdsCoreVersion>@(_SdsCore->'%(NuGetPackageVersion)'->Distinct())</_SdsCoreVersion>
            <_SdsStubVersion>@(_SdsStub->'%(NuGetPackageVersion)'->Distinct())</_SdsStubVersion>
        </PropertyGroup>
        <Error Condition="'$(_SdsCoreVersion)' != '' and '$(_SdsCoreVersion)' != '$(_SdsStubVersion)'" Text="System.Data.SQLite.Core is $(_SdsCoreVersion) but the SQLite.Interop natives come from Stub.System.Data.SQLite.Core.NetStandard $(_SdsStubVersion). Update the Stub package reference to match." />
        <Error Condition="!Exists('$(PkgStub_System_Data_SQLite_Core_NetStandard)/runtimes/win-x64/native/SQLite.Interop.dll')" Text="SQLite.Interop natives not found under '$(PkgStub_System_Data_SQLite_Core_NetStandard)'. Run dotnet restore." />
    </Target>
</Project>
